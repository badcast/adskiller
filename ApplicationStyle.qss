/* ===================================================================
 * AdsKiller Desktop - Unified Application Stylesheet
 * File: ApplicationStyle.qss
 * Palette: Deep Midnight Navy & Cyan Glow (Harmonized with page_auth)
 * =================================================================== */

/* ==========================================
 * 0. Global Window and Controls Styling
 * ========================================== */
QMainWindow {
    background-color: #0A0E1A;
}

QWidget#centralwidget {
    background-color: #0A0E1A;
}

QFrame#contentLayout {
    background-color: #0A0E1A;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #1E293B;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #334155;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #1E293B;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #334155;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

QCheckBox::indicator:checked {
    image: url(:/resources/checkbox-checked);
}

/* ==========================================
 * 1. Authentication Page (page_auth)
 * ========================================== */
QWidget#page_auth {
    background: qradialgradient(cx:0.5, cy:0.45, radius:0.8, fx:0.5, fy:0.4,
        stop:0 #111A2E, stop:0.55 #0A0E1A, stop:1 #04060A);
}

QFrame#frame_4 {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #141B2D, stop:1 #0B0F19);
    border: 1px solid rgba(56, 189, 248, 0.28);
    border-radius: 20px;
}

QFrame#mainapplogo {
    image: url(:/resources/app-logo);
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1E293B, stop:1 #0F172A);
    border: 1.5px solid rgba(56, 189, 248, 0.35);
    border-radius: 20px;
    padding: 10px;
}

QFrame#mainapplogo[holiday="true"] {
    image: url(:/resources/app-logo-merry);
}

QLabel#label_4 {
    background: transparent;
}

QLabel#label_12 {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    background: transparent;
}

QLineEdit#lineLoginEdit {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1.5px solid #1E293B;
    border-radius: 10px;
    padding: 0 14px;
    font-size: 13px;
    selection-background-color: #0284C7;
}

QLineEdit#lineLoginEdit:hover {
    border: 1.5px solid #334155;
    background-color: #131E35;
}

QLineEdit#lineLoginEdit:focus {
    border: 1.5px solid #38BDF8;
    background-color: #0F172A;
}

QLineEdit#lineLoginEdit:disabled {
    background-color: #0B101D;
    color: #475569;
    border-color: #1E293B;
}

QLabel#label_14 {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    background: transparent;
}

QLineEdit#linePassEdit {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1.5px solid #1E293B;
    border-radius: 10px;
    padding: 0 14px;
    font-size: 13px;
    selection-background-color: #0284C7;
}

QLineEdit#linePassEdit:hover {
    border: 1.5px solid #334155;
    background-color: #131E35;
}

QLineEdit#linePassEdit:focus {
    border: 1.5px solid #38BDF8;
    background-color: #0F172A;
}

QLineEdit#linePassEdit:disabled {
    background-color: #0B101D;
    color: #475569;
    border-color: #1E293B;
}

QPushButton#butShowPass {
    background-color: #0F172A;
    color: #94A3B8;
    border: 1.5px solid #1E293B;
    border-radius: 10px;
    font-size: 15px;
}

QPushButton#butShowPass:hover {
    background-color: #1E293B;
    border-color: #38BDF8;
    color: #38BDF8;
}

QPushButton#butShowPass:pressed {
    background-color: #0B101D;
    border-color: #0284C7;
}

QCheckBox#checkAutoLogin {
    color: #94A3B8;
    font-size: 12px;
    font-weight: 500;
    spacing: 8px;
    background: transparent;
}

QCheckBox#checkAutoLogin:hover {
    color: #E2E8F0;
}

QCheckBox#checkAutoLogin::indicator {
    width: 17px;
    height: 17px;
    border: 1.5px solid #334155;
    border-radius: 5px;
    background-color: #0F172A;
}

QCheckBox#checkAutoLogin::indicator:hover {
    border-color: #38BDF8;
    background-color: #131E35;
}

QCheckBox#checkAutoLogin::indicator:checked {
    background-color: #0284C7;
    border-color: #38BDF8;
    image: url(:/resources/checkbox-checked);
}

QLabel#label_2 {
    color: #38BDF8;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}

QCheckBox#checkConsent {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 400;
    spacing: 8px;
    background: transparent;
}

QCheckBox#checkConsent:hover {
    color: #E2E8F0;
}

QCheckBox#checkConsent::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #334155;
    border-radius: 4px;
    background-color: #0F172A;
}

QCheckBox#checkConsent::indicator:hover {
    border-color: #38BDF8;
    background-color: #131E35;
}

QCheckBox#checkConsent::indicator:checked {
    background-color: #0284C7;
    border-color: #38BDF8;
    image: url(:/resources/checkbox-checked);
}

QLabel#consentLabel {
    background: transparent;
    font-size: 11px;
}

QPushButton#authButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284C7, stop:1 #0EA5E9);
    color: #FFFFFF;
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QPushButton#authButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0369A1, stop:1 #38BDF8);
    border-color: #7DD3FC;
}

QPushButton#authButton:pressed {
    background: #0284C7;
    border-color: #0284C7;
}

QPushButton#authButton:disabled {
    background-color: #1E293B;
    border-color: #334155;
    color: #64748B;
}

QLabel#statusAuthText {
    color: #38BDF8;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
    padding: 2px 8px;
}

QLabel#label_auth_ver {
    color: #475569;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3px;
    background: transparent;
}

/* ==========================================
 * 2. Cabinet Page (page_cabinet)
 * ========================================== */
QWidget#page_cabinet {
    background-color: #0A0E1A;
}

QFrame#toplevel_up {
    background-color: #0B0F19;
    border-bottom: 1px solid #1E293B;
}

QLabel#label_6 {
    color: #F8FAFC;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 0.5px;
    font-style: normal;
    background: transparent;
}

QPushButton#logoutButton {
    background-color: rgba(239, 68, 68, 0.12);
    color: #F87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 12px;
}

QPushButton#logoutButton:hover {
    background-color: rgba(239, 68, 68, 0.22);
    color: #FFA3A3;
    border-color: rgba(239, 68, 68, 0.5);
}

QPushButton#logoutButton:pressed {
    background-color: rgba(239, 68, 68, 0.35);
}

QPushButton#authpageUpdate {
    background-color: #0F172A;
    border: 1.5px solid #1E293B;
    border-radius: 8px;
    color: #38BDF8;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 12px;
}

QPushButton#authpageUpdate:hover {
    background-color: #131E35;
    border-color: #38BDF8;
    color: #FFFFFF;
}

QPushButton#authpageUpdate:pressed {
    background-color: #0B101D;
    border-color: #0284C7;
}

QFrame#frame_7 {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #141B2D, stop:1 #0B0F19);
    border: 1px solid rgba(56, 189, 248, 0.28);
    border-radius: 16px;
}

QFrame#authedMainWin {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #141B2D, stop:1 #0B0F19);
    border: 1px solid #1E293B;
    border-radius: 14px;
}

QFrame#frame_3 {
    image: url(:/resources/no-avatar);
    border: 2px solid #38BDF8;
    border-radius: 29px;
    background-color: #0F172A;
    padding: 3px;
}

QLabel#labelLoginAuthed {
    color: #F8FAFC;
    font-size: 15px;
    font-weight: bold;
    text-decoration: none;
    background: transparent;
}

QFrame#frame_6 {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #251B0E, stop:1 #140E06);
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: 12px;
}

QPushButton#buttonAddVip {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:0, stop:0 #D97706, stop:1 #F59E0B);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: bold;
    border: none;
    border-radius: 6px;
    padding: 2px 8px;
}

QPushButton#buttonAddVip:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:0, stop:0 #F59E0B, stop:1 #FBBF24);
}

QPushButton#buttonAddVip:pressed {
    background: #B45309;
}

QLabel#labelVipDays {
    color: #FBBF24;
    font-size: 13.5px;
    font-weight: bold;
    text-decoration: none;
    line-height: 1.4;
    background: transparent;
}

QFrame#frame_5 {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0B2319, stop:1 #06150E);
    border: 1px solid rgba(52, 211, 153, 0.4);
    border-radius: 12px;
}

QLabel#labelCredits {
    color: #34D399;
    font-size: 13.5px;
    font-weight: bold;
    text-decoration: none;
    line-height: 1.4;
    background: transparent;
}

QFrame#toplevel_up_2 {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 8px;
}

QLabel#label_7 {
    color: #38BDF8;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1.2px;
    background: transparent;
}

QFrame#serviceContents {
    background: transparent;
    border: none;
}

QFrame#cabinetSideInfoPanel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #141B2D, stop:1 #0B0F19);
    border: 1px solid #1E293B;
    border-radius: 14px;
}

QLabel#cabinetSideTitle {
    color: #38BDF8;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1.1px;
    background: transparent;
    padding-bottom: 6px;
    border-bottom: 1px solid #1E293B;
}

QFrame#cabinetSideRow {
    background-color: #0D1527;
    border: 1px solid #1E293B;
    border-radius: 8px;
}

QLabel#cabinetSideIcon {
    background-color: #141B2D;
    color: #38BDF8;
    border-radius: 6px;
    font-size: 13px;
}

QLabel#cabinetSideCaption {
    color: #64748B;
    font-size: 10px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel[cabinetVal="true"],
QLabel#cabinetVal_login,
QLabel#cabinetVal_loginTime,
QLabel#cabinetVal_credits,
QLabel#cabinetVal_vip,
QLabel#cabinetVal_devices,
QLabel#cabinetVal_location,
QLabel#cabinetVal_status {
    color: #F1F5F9;
    font-size: 12px;
    font-weight: bold;
    background: transparent;
    border: none;
}

/* ==========================================
 * 3. Devices Connection Page (page_devices)
 * ========================================== */
QWidget#page_devices {
    background-color: #0A0E1A;
}

QScrollArea#scrollArea_2 {
    background: transparent;
    border: none;
}

QWidget#scrollAreaWidgetContents_2 {
    background: transparent;
}

QFrame#device_left_group {
    background-color: #0F172A;
    border: 1px solid rgba(56, 189, 248, 0.28);
    border-radius: 16px;
}

QLabel#label_5 {
    background-color: #0B1120;
    border: 1px solid #1E3A5F;
    border-radius: 10px;
    color: #38BDF8;
    font-size: 12.5px;
    font-weight: 600;
    padding: 10px;
}

/* ==========================================
 * 4. Procedures & Scan Execution (page_adsmalware)
 * ========================================== */
QWidget#page_adsmalware {
    background-color: #0A0E1A;
}

QLabel#deviceLabelName {
    background-color: #0F172A;
    border: 1.5px solid #1E293B;
    border-radius: 10px;
    color: #38BDF8;
    font-size: 14px;
    font-weight: bold;
    font-style: normal;
    padding: 8px 16px;
}

QListView#processLogStatus {
    background-color: #080C14;
    border: 1px solid #1E293B;
    border-radius: 10px;
    color: #94A3B8;
    font-family: 'Consolas', 'DejaVu Sans Mono', 'Courier New', monospace;
    font-size: 11px;
    padding: 8px;
}

QListView#processLogStatus::item:selected {
    background-color: #0284C7;
    color: #FFFFFF;
}

QProgressBar#processBarStatus {
    background-color: #0B0F19;
    border: 1px solid #1E293B;
    border-radius: 6px;
    height: 16px;
    text-align: center;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: bold;
}

QProgressBar#processBarStatus::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284C7, stop:1 #38BDF8);
    border-radius: 5px;
}

QLabel#malwareStatusText0 {
    color: #F8FAFC;
    font-size: 14px;
    font-weight: 600;
    padding: 6px;
    font-style: normal;
    text-decoration: none;
}

QPushButton#malwareReRun {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284C7, stop:1 #0EA5E9);
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 20px;
}

QPushButton#malwareReRun:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0369A1, stop:1 #38BDF8);
    border-color: #7DD3FC;
}

QPushButton#malwareReRun:pressed {
    background: #0284C7;
    border-color: #0284C7;
}

/* ==========================================
 * 5. Loader Page (page_loader)
 * ========================================== */
QWidget#page_loader {
    background-color: #0A0E1A;
}

QFrame#frame_loader {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #141B2D, stop:1 #0B0F19);
    border: 1px solid rgba(56, 189, 248, 0.28);
    border-radius: 20px;
}

QLabel#loaderPageText {
    color: #38BDF8;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

/* ==========================================
 * 6. My Devices & Warranty Page (page_mydevices)
 * ========================================== */
QWidget#page_mydevices {
    background-color: #0A0E1A;
}

QLabel#label_9,
QLabel#label_10 {
    color: #94A3B8;
    font-size: 12px;
    font-weight: 600;
}

QDateEdit#myDeviceFilterDateStart,
QDateEdit#myDeviceFilterDateEnd {
    background-color: #0F172A;
    border: 1.5px solid #1E293B;
    border-radius: 8px;
    color: #F8FAFC;
    font-size: 12px;
    padding: 4px 8px;
}

QDateEdit#myDeviceFilterDateStart:hover,
QDateEdit#myDeviceFilterDateEnd:hover {
    border-color: #334155;
    background-color: #131E35;
}

QDateEdit#myDeviceFilterDateStart:focus,
QDateEdit#myDeviceFilterDateEnd:focus {
    border: 1.5px solid #38BDF8;
    background-color: #0F172A;
}

QCheckBox#myDeviceQuaranteeFilter {
    color: #94A3B8;
    font-size: 12px;
    font-weight: 500;
    spacing: 8px;
}

QCheckBox#myDeviceQuaranteeFilter::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #334155;
    border-radius: 4px;
    background-color: #0F172A;
}

QCheckBox#myDeviceQuaranteeFilter::indicator:hover {
    border-color: #38BDF8;
    background-color: #131E35;
}

QCheckBox#myDeviceQuaranteeFilter::indicator:checked {
    background-color: #0284C7;
    border-color: #38BDF8;
    image: url(:/resources/checkbox-checked);
}

QPushButton#myDeviceSend {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284C7, stop:1 #0EA5E9);
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    padding: 5px 16px;
}

QPushButton#myDeviceSend:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0369A1, stop:1 #38BDF8);
    border-color: #7DD3FC;
}

QPushButton#myDeviceSend:pressed {
    background: #0284C7;
}

QTableView#tableActual,
QTableView#myDeviceActual {
    background-color: #0B0F19;
    alternate-background-color: #0F172A;
    gridline-color: #161F33;
    border: 1px solid #1E293B;
    border-radius: 10px;
    color: #F8FAFC;
    font-size: 12px;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
}

QTableView#tableActual QHeaderView::section,
QTableView#myDeviceActual QHeaderView::section {
    background-color: #0F172A;
    color: #94A3B8;
    font-size: 12px;
    font-weight: bold;
    border: none;
    border-bottom: 1px solid #1E293B;
    border-right: 1px solid #161F33;
    padding: 6px 10px;
}

QLabel#myDevicePageLabel {
    color: #64748B;
    font-size: 11px;
    padding: 4px;
}

/* ==========================================
 * 7. VIP Subscription Page (page_buyvip)
 * ========================================== */
QWidget#page_buyvip {
    background-color: #0A0E1A;
}

QGroupBox#groupBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #141B2D, stop:1 #0B0F19);
    border: 1px solid rgba(56, 189, 248, 0.28);
    border-radius: 16px;
    margin-top: 24px;
    padding: 24px 20px 20px 20px;
    font-size: 15px;
    font-weight: bold;
    color: #F8FAFC;
}

QGroupBox#groupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 4px 16px;
    background-color: #0F172A;
    border: 1.5px solid #1E293B;
    border-radius: 8px;
    color: #38BDF8;
    font-weight: bold;
}

QLabel#label_13 {
    color: #94A3B8;
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 4px;
}

QLabel#labelVipBalance {
    background-color: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    border-radius: 8px;
    color: #34D399;
    font-size: 14px;
    font-weight: bold;
    padding: 10px 14px;
}

QComboBox#comboBoxSelectVIPDays {
    background-color: #0F172A;
    border: 1.5px solid #1E293B;
    border-radius: 8px;
    color: #F8FAFC;
    font-size: 13px;
    padding: 6px 12px;
    min-height: 24px;
}

QComboBox#comboBoxSelectVIPDays:hover {
    border-color: #38BDF8;
    background-color: #131E35;
}

QComboBox#comboBoxSelectVIPDays::drop-down {
    border: none;
    width: 24px;
}

QComboBox#comboBoxSelectVIPDays QAbstractItemView {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
    color: #F8FAFC;
    padding: 4px;
}

QFrame#frame {
    background-color: #0D1527;
    border: 1px solid #1E293B;
    border-radius: 10px;
    padding: 10px;
}

QLabel#labelInfoVip {
    color: #F8FAFC;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#buttonBuyVip {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #10B981, stop:1 #059669);
    border: 1px solid rgba(52, 211, 153, 0.4);
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: bold;
    padding: 8px 20px;
}

QPushButton#buttonBuyVip:hover {
    background: #10B981;
    border-color: #34D399;
}

QPushButton#buttonBuyVip:pressed {
    background: #047857;
}

/* ==========================================
 * 8. Top Back Bar (toplevel_backpage)
 * ========================================== */
QFrame#toplevel_backpage {
    background-color: #0B0F19;
    border-bottom: 1px solid #1E293B;
}

QPushButton#buttonBackTo {
    background-color: #0F172A;
    border: 1.5px solid #1E293B;
    border-radius: 8px;
    color: #94A3B8;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 14px;
}

QPushButton#buttonBackTo:hover {
    background-color: #131E35;
    border-color: #38BDF8;
    color: #38BDF8;
}

QPushButton#buttonBackTo:pressed {
    background-color: #0B101D;
    border-color: #0284C7;
}

QLabel#label_8 {
    color: #F8FAFC;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 0.5px;
    font-style: normal;
    background: transparent;
}

/* ==========================================
 * 9. AI Panel & Chat Interface
 * ========================================== */
QFrame#aiToolBoxContainer {
    background-color: transparent;
    border: none;
}

QPushButton#aiToolBoxToggle {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #141B2D, stop:1 #0B0F19);
    color: #38BDF8;
    border: 1px solid rgba(56, 189, 248, 0.28);
    border-right: none;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    font-size: 11px;
    font-weight: bold;
    padding: 6px 2px;
    text-align: center;
}

QPushButton#aiToolBoxToggle:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1E293B, stop:1 #131E35);
    border: 1px solid #38BDF8;
    border-right: none;
    color: #FFFFFF;
}

QPushButton#aiToolBoxToggle:pressed {
    background: #0B101D;
    border: 1px solid #0284C7;
    border-right: none;
}

QWidget#aiMainPanel {
    background-color: #0B0F19;
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 12px;
}

QWidget#aiHeaderBar {
    background-color: #0F172A;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom: 1px solid #1E293B;
}

QLabel#aiTitle {
    color: #F8FAFC;
    font-size: 12px;
    font-weight: 600;
}

QLabel#aiStatus {
    color: #34D399;
    font-size: 8px;
    margin-top: 1px;
}

QFrame#aiSegmentedBar {
    background-color: #0B0F19;
    border: 1px solid #1E293B;
    border-radius: 6px;
}

QFrame#aiSegmentedBar QPushButton,
QPushButton#tabChatBtn,
QPushButton#tabInfoBtn {
    background: transparent;
    color: #94A3B8;
    border: none;
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 10.5px;
    font-weight: 500;
}

QFrame#aiSegmentedBar QPushButton:hover,
QPushButton#tabChatBtn:hover,
QPushButton#tabInfoBtn:hover {
    color: #FFFFFF;
    background: rgba(56, 189, 248, 0.1);
}

QFrame#aiSegmentedBar QPushButton:checked,
QPushButton#tabChatBtn:checked,
QPushButton#tabInfoBtn:checked {
    background: #141B2D;
    color: #38BDF8;
    border: 1px solid rgba(56, 189, 248, 0.3);
    font-weight: bold;
}

QPushButton#aiHeaderCollapseBtn {
    background: #0F172A;
    color: #94A3B8;
    border: 1.5px solid #1E293B;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#aiHeaderCollapseBtn:hover {
    background: #131E35;
    border-color: #38BDF8;
    color: #38BDF8;
}

QPushButton#aiHeaderCollapseBtn:pressed {
    background: #0B101D;
    border-color: #0284C7;
}

QStackedWidget#aiStack {
    background: transparent;
    border: none;
}

QWidget#aiToolBoxPage2 {
    background-color: #0B0F19;
    border: none;
}

QTextEdit#aboutAi_edit {
    background-color: #0B0F19;
    color: #E2E8F0;
    border: none;
    padding: 14px 14px;
    font-size: 11px;
}

QWidget#aiToolBoxPage1 {
    background-color: #0B0F19;
    border: none;
}

QWidget#aiQuickBarWidget {
    background: transparent;
}

QPushButton#aiShuffleBtn {
    background: #0F172A;
    color: #94A3B8;
    border: 1px solid #1E293B;
    border-radius: 13px;
    font-size: 11px;
    padding: 0px;
}

QPushButton#aiShuffleBtn:hover {
    background: #131E35;
    border-color: #38BDF8;
    color: #38BDF8;
}

QPushButton#aiShuffleBtn:pressed {
    background: #0B101D;
}

QScrollArea#aiQuickScrollArea {
    border: none;
    background: transparent;
}

QWidget#aiQuickButtonsWidget {
    background: transparent;
}

QWidget#aiQuickButtonsWidget QPushButton,
QPushButton#aiQuickBtn {
    background: #0F172A;
    color: #94A3B8;
    border: 1px solid #1E293B;
    border-radius: 13px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
}

QWidget#aiQuickButtonsWidget QPushButton:hover,
QPushButton#aiQuickBtn:hover {
    background: #131E35;
    border: 1px solid #38BDF8;
    color: #38BDF8;
}

QWidget#aiQuickButtonsWidget QPushButton:pressed,
QPushButton#aiQuickBtn:pressed {
    background-color: #0B101D;
    color: #FFFFFF;
}

QFrame#aiInputCapsule {
    background-color: #0F172A;
    border: 1.5px solid #1E293B;
    border-radius: 12px;
}

QFrame#aiInputCapsule[focused="true"] {
    background-color: #0F172A;
    border: 1.5px solid #38BDF8;
    border-radius: 12px;
}

QTextEdit#aiChatEdit {
    background: transparent;
    color: #F8FAFC;
    border: none;
    padding: 4px 2px;
    font-size: 11.5px;
    selection-background-color: #0284C7;
}

QPushButton#aiChatSend {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284C7, stop:1 #0EA5E9);
    color: #FFFFFF;
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-radius: 15px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#aiChatSend:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0369A1, stop:1 #38BDF8);
    border-color: #7DD3FC;
}

QPushButton#aiChatSend:pressed {
    background: #0284C7;
    border-color: #0284C7;
}

QPushButton#aiChatSend:disabled {
    background: #1E293B;
    border-color: #334155;
    color: #64748B;
}

/* ==========================================
 * 10. File Manager & APK Manager Pages
 * ========================================== */
QWidget#page_filemanager,
QWidget#page_apkmanager,
QWidget#page_contactfixer {
    background-color: #0A0E1A;
}

QWidget#page_filemanager QTableWidget,
QWidget#page_apkmanager QTableWidget,
QWidget#page_contactfixer QTableWidget {
    background-color: #0B0F19;
    alternate-background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 10px;
    gridline-color: #161F33;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
    font-size: 12px;
}

QWidget#page_filemanager QHeaderView::section,
QWidget#page_apkmanager QHeaderView::section,
QWidget#page_contactfixer QHeaderView::section {
    background-color: #0F172A;
    color: #94A3B8;
    font-weight: 700;
    font-size: 11px;
    border: none;
    border-bottom: 1px solid #1E293B;
    padding: 7px 10px;
}

QWidget#page_filemanager QLineEdit,
QWidget#page_apkmanager QLineEdit,
QWidget#page_contactfixer QLineEdit {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1.5px solid #1E293B;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    selection-background-color: #0284C7;
}

QWidget#page_filemanager QLineEdit:hover,
QWidget#page_apkmanager QLineEdit:hover,
QWidget#page_contactfixer QLineEdit:hover {
    border-color: #334155;
    background-color: #131E35;
}

QWidget#page_filemanager QLineEdit:focus,
QWidget#page_apkmanager QLineEdit:focus,
QWidget#page_contactfixer QLineEdit:focus {
    border-color: #38BDF8;
    background-color: #0F172A;
}

QWidget#page_filemanager QPushButton,
QWidget#page_apkmanager QPushButton,
QWidget#page_contactfixer QPushButton {
    background-color: #0F172A;
    color: #E2E8F0;
    border: 1.5px solid #1E293B;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QWidget#page_filemanager QPushButton:hover,
QWidget#page_apkmanager QPushButton:hover,
QWidget#page_contactfixer QPushButton:hover {
    background-color: #131E35;
    border-color: #38BDF8;
    color: #38BDF8;
}

QWidget#page_filemanager QPushButton:pressed,
QWidget#page_apkmanager QPushButton:pressed,
QWidget#page_contactfixer QPushButton:pressed {
    background-color: #0B101D;
    border-color: #0284C7;
}

QWidget#page_filemanager QPushButton:disabled,
QWidget#page_apkmanager QPushButton:disabled,
QWidget#page_contactfixer QPushButton:disabled {
    background-color: #0B101D;
    color: #475569;
    border-color: #1E293B;
}

QWidget#page_apkmanager QTabWidget::pane {
    border: 1px solid #1E293B;
    background-color: #0B0F19;
    border-radius: 10px;
}

QWidget#page_apkmanager QTabBar::tab {
    background: #0F172A;
    color: #94A3B8;
    padding: 7px 16px;
    font-size: 11.5px;
    font-weight: 600;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 3px;
    border: 1px solid #1E293B;
    border-bottom: none;
}

QWidget#page_apkmanager QTabBar::tab:selected {
    background: #0B0F19;
    color: #38BDF8;
    border-bottom: 2px solid #38BDF8;
}

QWidget#page_apkmanager QTabBar::tab:hover:!selected {
    background: #131E35;
    color: #FFFFFF;
}

QWidget#page_apkmanager QTextEdit {
    background-color: #070A12;
    color: #E2E8F0;
    border: 1px solid #1E293B;
    border-radius: 8px;
    selection-background-color: #0284C7;
}

QWidget#page_apkmanager QComboBox {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1.5px solid #1E293B;
    border-radius: 8px;
    padding: 6px 12px;
}

QWidget#page_apkmanager QComboBox:hover {
    border-color: #38BDF8;
    background-color: #131E35;
}

QWidget#page_apkmanager QComboBox QAbstractItemView {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
    padding: 4px;
}
