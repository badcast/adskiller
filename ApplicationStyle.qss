}

QWidget#page_filemanager QPushButton,
QWidget#page_apkmanager QPushButton,
QWidget#page_contactfixer QPushButton {
    background-color: #0F172A;
    color: #E2E8F0;
    border: 1px solid #1E293B;
    border-radius: 0px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QWidget#page_filemanager QPushButton:hover,
QWidget#page_apkmanager QPushButton:hover,
QWidget#page_contactfixer QPushButton:hover {
    background-color: #131E35;
    border-color: #38BDF8;
