}

QWidget#page_apkmanager QComboBox:hover {
    border-color: #38BDF8;
    background-color: #131E35;
}

QWidget#page_apkmanager QComboBox QAbstractItemView {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 0px;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
    padding: 4px;
}

/* ==========================================
 * 11. Global Metro UI Fallback Rules
 * ========================================== */
QDialog {
    background-color: #0A0E1A;
    border: 1px solid #1E293B;
    border-radius: 0px;
}

QDialog QLabel {
    color: #F8FAFC;
    background-color: transparent;
}

QDialog QPushButton {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 0px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
    min-width: 75px;
}

QDialog QPushButton:hover {
    background-color: #334155;
    border-color: #38BDF8;
    color: #FFFFFF;
}

QDialog QPushButton:pressed {
    background-color: #0284C7;
    border-color: #38BDF8;
}

QMessageBox {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 0px;
}

QMessageBox QLabel {
    color: #F8FAFC;
    background: transparent;
}

QMessageBox QPushButton {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 0px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: bold;
    min-width: 80px;
}

QMessageBox QPushButton:hover {
    background-color: #334155;
    border-color: #38BDF8;
}

QMessageBox QPushButton:pressed {
    background-color: #0F172A;
}

QTabWidget::pane {
    border: 1px solid #1E293B;
    background-color: #0B0F19;
    border-radius: 0px;
}

QTabBar::tab {
    background-color: #0F172A;
    color: #94A3B8;
    padding: 7px 16px;
    font-size: 11.5px;
    font-weight: 600;
    border: 1px solid #1E293B;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #0B0F19;
    color: #38BDF8;
    border-bottom: 2px solid #38BDF8;
}

QTabBar::tab:hover:!selected {
    background-color: #131E35;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #0F172A;
    color: #94A3B8;
    font-weight: 700;
    font-size: 11px;
    border: none;
    border-bottom: 1px solid #1E293B;
    border-right: 1px solid #161F33;
    padding: 6px 10px;
}
