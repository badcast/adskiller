/* ===================================================================
 * AdsKiller Desktop - Metro UI Unified Application Stylesheet
 * File: ApplicationStyle.qss
 * Style: Modern Metro UI (Flat, Sharp, Clean Typography, Zero Radius)
 * Palette: Midnight Obsidian, Electric Cyan (#38BDF8), Metro Blue (#0284C7)
 * =================================================================== */

/* ==========================================
 * 0. Global Window and Controls Styling
 * ========================================== */
QWidget {
    color: #F8FAFC;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 12px;
}

QMainWindow,
QDialog {
    background-color: #0A0E1A;
    color: #F8FAFC;
}

QWidget#centralwidget {
    background-color: #0A0E1A;
}

QFrame#contentLayout {
    background-color: #0A0E1A;
    border: none;
}

/* Base Labels */
QLabel {
    background-color: transparent;
    color: #F8FAFC;
}

QLabel:disabled {
    color: #475569;
}

/* Base PushButtons (Metro Flat Default) */
QPushButton {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 0px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    outline: none;
}

QPushButton:hover {
    background-color: #1E293B;
    border-color: #38BDF8;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #0284C7;
    border-color: #38BDF8;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #0B101D;
    color: #475569;
    border-color: #1E293B;
}

/* Base Text Inputs & Edits */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QTextBrowser {
    background-color: #070A12;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 0px;
    padding: 5px 8px;
    font-size: 12px;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QTextBrowser:hover {
    border-color: #334155;
    background-color: #0B101D;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QTextBrowser:focus {
    border: 1px solid #38BDF8;
    background-color: #0F172A;
    color: #F8FAFC;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QTextBrowser:disabled {
    background-color: #0B101D;
    color: #475569;
    border-color: #1E293B;
}

/* Base ComboBox */
QComboBox {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 0px;
    padding: 4px 10px;
    font-size: 12px;
    min-height: 24px;
}

QComboBox:hover {
    border-color: #38BDF8;
    background-color: #131E35;
}

QComboBox:focus {
    border: 1px solid #38BDF8;
}

QComboBox:disabled {
    background-color: #0B101D;
    color: #475569;
    border-color: #1E293B;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #1E293B;
    background-color: #0F172A;
}

QComboBox::drop-down:hover {
    background-color: #1E293B;
}

QComboBox QAbstractItemView {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 0px;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
    outline: none;
    padding: 2px;
}

/* Base Item Views (Tables, Lists, Trees) */
QAbstractItemView,
QTableView,
QTableWidget,
QListView,
QListWidget,
QTreeView,
QTreeWidget {
    background-color: #070A12;
    alternate-background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 0px;
    gridline-color: #161F33;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
    outline: none;
}

QAbstractItemView::item:hover,
QTableView::item:hover,
QTableWidget::item:hover,
QListView::item:hover,
QListWidget::item:hover {
    background-color: #131E35;
    color: #38BDF8;
}

QAbstractItemView::item:selected,
QTableView::item:selected,
QTableWidget::item:selected,
QListView::item:selected,
QListWidget::item:selected {
    background-color: #0284C7;
    color: #FFFFFF;
}

/* Base Headers */
QHeaderView {
    background-color: #0B1120;
    border: none;
}

QHeaderView::section {
    background-color: #0B1120;
    color: #94A3B8;
    font-weight: 700;
    font-size: 11px;
    border: none;
    border-bottom: 1px solid #1E293B;
    border-right: 1px solid #161F33;
    padding: 6px 10px;
}

QTableCornerButton::section {
    background-color: #0B1120;
    border: none;
    border-bottom: 1px solid #1E293B;
    border-right: 1px solid #161F33;
}

/* Base ScrollArea */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Base TabWidget and TabBar */
QTabWidget::pane {
    border: 1px solid #1E293B;
    background-color: #0A0E1A;
    border-radius: 0px;
}

QTabBar::tab {
    background-color: #0F172A;
    color: #94A3B8;
    padding: 7px 16px;
    font-size: 11.5px;
    font-weight: 600;
    border: 1px solid #1E293B;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #0A0E1A;
    color: #38BDF8;
    border-bottom: 2px solid #38BDF8;
}

QTabBar::tab:hover:!selected {
    background-color: #131E35;
    color: #FFFFFF;
}

/* Base GroupBox */
QGroupBox {
    border: 1px solid #1E293B;
    border-radius: 0px;
    margin-top: 14px;
    padding-top: 12px;
    color: #38BDF8;
    font-weight: 700;
    font-size: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 6px;
    background-color: #0A0E1A;
}

/* SpinBoxes */
QSpinBox,
QDoubleSpinBox {
    background-color: #070A12;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 0px;
    padding: 4px 8px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #38BDF8;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    width: 16px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #1E293B;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #1E293B;
    border-radius: 0px;
}

QSlider::sub-page:horizontal {
    background-color: #0284C7;
    border-radius: 0px;
}

QSlider::handle:horizontal {
    background-color: #38BDF8;
    border: 1px solid #38BDF8;
    width: 12px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 0px;
}

QSlider::handle:horizontal:hover {
    background-color: #FFFFFF;
    border-color: #FFFFFF;
}

/* ProgressBars */
QProgressBar {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 0px;
    text-align: center;
    color: #F8FAFC;
    font-size: 11px;
    font-weight: 600;
    height: 14px;
}

QProgressBar::chunk {
    background-color: #0284C7;
}

/* MenuBar and Menus */
QMenuBar {
    background-color: #0A0E1A;
    color: #F8FAFC;
    border-bottom: 1px solid #1E293B;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    color: #F8FAFC;
}

QMenuBar::item:selected {
    background-color: #1E293B;
    color: #38BDF8;
}

QMenuBar::item:pressed {
    background-color: #0284C7;
    color: #FFFFFF;
}

/* StatusBar */
QStatusBar {
    background-color: #070A12;
    color: #94A3B8;
    border-top: 1px solid #1E293B;
}

QStatusBar::item {
    border: none;
}

/* Metro Flat Scrollbars */
QScrollBar:vertical {
    background-color: #0A0E1A;
    width: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #1E293B;
    border-radius: 0px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #38BDF8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background-color: #0A0E1A;
    height: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #1E293B;
    border-radius: 0px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #38BDF8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* Global CheckBoxes */
QCheckBox {
    color: #F8FAFC;
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #334155;
    border-radius: 0px;
    background-color: #0F172A;
}

QCheckBox::indicator:hover {
    border-color: #38BDF8;
    background-color: #131E35;
}

QCheckBox::indicator:checked {
    background-color: #0284C7;
    border-color: #38BDF8;
    image: url(:/resources/checkbox-checked);
}

/* Global RadioButtons */
QRadioButton {
    color: #F8FAFC;
    spacing: 8px;
    background: transparent;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #334155;
    border-radius: 0px;
    background-color: #0F172A;
}

QRadioButton::indicator:hover {
    border-color: #38BDF8;
}

QRadioButton::indicator:checked {
    background-color: #0284C7;
    border-color: #38BDF8;
}

/* Tooltips */
QToolTip {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #38BDF8;
    border-radius: 0px;
    padding: 5px 8px;
    font-size: 11px;
}

/* Context Menus */
QMenu {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 0px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 6px 20px;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #0284C7;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #1E293B;
    margin: 4px 0px;
}

/* ==========================================
 * 1. Authentication Page (page_auth)
 * ========================================== */
QWidget#page_auth {
    background-color: #070A12;
}

QFrame#frame_4 {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 0px;
}

QFrame#mainapplogo {
    image: url(:/resources/app-logo);
    background-color: #0B0F19;
    border: 1px solid #1E293B;
    border-radius: 0px;
    padding: 10px;
}

QFrame#mainapplogo[holiday="true"] {
    image: url(:/resources/app-logo-merry);
}

QLabel#label_4 {
    background: transparent;
}

QLabel#label_12 {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    background: transparent;
}

QLineEdit#lineLoginEdit {
    background-color: #070A12;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 0px;
    padding: 0 10px;
    font-size: 13px;
    selection-background-color: #0284C7;
}

QLineEdit#lineLoginEdit:hover {
    border-color: #334155;
    background-color: #0B101D;
}

QLineEdit#lineLoginEdit:focus {
    border: 1px solid #38BDF8;
    background-color: #0F172A;
}

QLineEdit#lineLoginEdit:disabled {
    background-color: #0B101D;
    color: #475569;
    border-color: #1E293B;
}

QLabel#label_14 {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    background: transparent;
}

QLineEdit#linePassEdit {
    background-color: #070A12;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 0px;
    padding: 0 10px;
    font-size: 13px;
    selection-background-color: #0284C7;
}

QLineEdit#linePassEdit:hover {
    border-color: #334155;
    background-color: #0B101D;
}

QLineEdit#linePassEdit:focus {
    border: 1px solid #38BDF8;
    background-color: #0F172A;
}

QLineEdit#linePassEdit:disabled {
    background-color: #0B101D;
    color: #475569;
    border-color: #1E293B;
}

QPushButton#butShowPass {
    background-color: #0F172A;
    color: #94A3B8;
    border: 1px solid #1E293B;
    border-radius: 0px;
    font-size: 15px;
}

QPushButton#butShowPass:hover {
    background-color: #1E293B;
    border-color: #38BDF8;
    color: #38BDF8;
}

QPushButton#butShowPass:pressed {
    background-color: #0B101D;
    border-color: #0284C7;
}

QCheckBox#checkAutoLogin {
    color: #94A3B8;
    font-size: 12px;
    font-weight: 500;
    spacing: 8px;
    background: transparent;
}

QCheckBox#checkAutoLogin:hover {
    color: #E2E8F0;
}

QCheckBox#checkAutoLogin::indicator {
    width: 17px;
    height: 17px;
    border: 1px solid #334155;
    border-radius: 0px;
    background-color: #0F172A;
}

QCheckBox#checkAutoLogin::indicator:hover {
    border-color: #38BDF8;
    background-color: #131E35;
}

QCheckBox#checkAutoLogin::indicator:checked {
    background-color: #0284C7;
    border-color: #38BDF8;
    image: url(:/resources/checkbox-checked);
}

QLabel#label_2 {
    color: #38BDF8;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}

QCheckBox#checkConsent {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 400;
    spacing: 8px;
    background: transparent;
}

QCheckBox#checkConsent:hover {
    color: #E2E8F0;
}

QCheckBox#checkConsent::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #334155;
    border-radius: 0px;
    background-color: #0F172A;
}

QCheckBox#checkConsent::indicator:hover {
    border-color: #38BDF8;
    background-color: #131E35;
}

QCheckBox#checkConsent::indicator:checked {
    background-color: #0284C7;
    border-color: #38BDF8;
    image: url(:/resources/checkbox-checked);
}

QLabel#consentLabel {
    background: transparent;
    font-size: 11px;
}

QPushButton#authButton {
    background-color: #0284C7;
    color: #FFFFFF;
    border: 1px solid #0284C7;
    border-radius: 0px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QPushButton#authButton:hover {
    background-color: #0369A1;
    border-color: #38BDF8;
}

QPushButton#authButton:pressed {
    background-color: #075985;
    border-color: #0284C7;
}

QPushButton#authButton:disabled {
    background-color: #1E293B;
    border-color: #334155;
    color: #64748B;
}

QLabel#statusAuthText {
    color: #38BDF8;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
    padding: 2px 8px;
}

QLabel#label_auth_ver {
    color: #475569;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3px;
    background: transparent;
}

/* ==========================================
 * 2. Cabinet Page (page_cabinet)
 * ========================================== */
QWidget#page_cabinet {
    background-color: #0A0E1A;
}

QFrame#toplevel_up {
    background-color: #0B0F19;
    border-bottom: 1px solid #1E293B;
}

QLabel#label_6 {
    color: #F8FAFC;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 0.5px;
    font-style: normal;
    background: transparent;
}

QPushButton#logoutButton {
    background-color: #1E1218;
    color: #F87171;
    border: 1px solid #7F1D1D;
    border-radius: 0px;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 12px;
}

QPushButton#logoutButton:hover {
    background-color: #7F1D1D;
    color: #FFFFFF;
    border-color: #EF4444;
}

QPushButton#logoutButton:pressed {
    background-color: #450A0A;
    border-color: #991B1B;
}

QPushButton#authpageUpdate {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 0px;
    color: #38BDF8;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 12px;
}

QPushButton#authpageUpdate:hover {
    background-color: #1E293B;
    border-color: #38BDF8;
    color: #FFFFFF;
}

QPushButton#authpageUpdate:pressed {
    background-color: #0B101D;
    border-color: #0284C7;
}

QFrame#frame_7 {
    background-color: #0B0F19;
    border: 1px solid #1E293B;
    border-radius: 0px;
    padding: 6px 12px;
}

QFrame#authedMainWin {
    background: transparent;
    border: none;
    border-radius: 0px;
}

QFrame#frame_3 {
    image: url(:/resources/no-avatar);
    border: 1.5px solid #38BDF8;
    border-radius: 0px;
    background-color: #0F172A;
    padding: 2px;
}

QLabel#labelLoginAuthed {
    color: #F8FAFC;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    background: transparent;
    border: none;
}

QLabel#cabinetRoleBadge {
    color: #64748B;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    background: transparent;
    border: none;
}

QLabel#cabinetOnlineBadge {
    color: #34D399;
    background-color: rgba(52, 211, 153, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.30);
    border-radius: 0px;
    font-size: 9.5px;
    font-weight: 700;
    padding: 2px 7px;
}

QPushButton#buttonAddCredits {
    background-color: #065F46;
    color: #FFFFFF;
    font-size: 11.5px;
    font-weight: 700;
    border: 1px solid #059669;
    border-radius: 0px;
    padding: 4px 12px;
}

QPushButton#buttonAddCredits:hover {
    background-color: #059669;
    border-color: #34D399;
}

QPushButton#buttonAddCredits:pressed {
    background-color: #047857;
}

QPushButton#buttonAddVip {
    background-color: #0284C7;
    color: #FFFFFF;
    font-size: 11.5px;
    font-weight: 700;
    border: 1px solid #0284C7;
    border-radius: 0px;
    padding: 4px 12px;
}

QPushButton#buttonAddVip:hover {
    background-color: #0369A1;
    border-color: #38BDF8;
}

QPushButton#buttonAddVip:pressed {
    background-color: #075985;
}

QFrame#cabinetHorizontalDivider {
    background-color: #1E293B;
    max-height: 1px;
    border: none;
}

QFrame#cabinetHorizontalRefPanel {
    background: transparent;
    border: none;
}

QFrame#cabinetSideRow,
QFrame[cabinetChip="true"] {
    background-color: #070B14;
    border: 1px solid #1E293B;
    border-radius: 0px;
    padding: 2px 6px;
}

QFrame#cabinetSideRow:hover,
QFrame[cabinetChip="true"]:hover {
    border-color: #334155;
    background-color: #0E1526;
}

QLabel#cabinetSideIcon {
    background: transparent;
    border: none;
}

QLabel#cabinetSideCaption {
    color: #64748B;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    background: transparent;
    border: none;
}

QLabel[cabinetVal="true"],
QLabel#cabinetVal_login,
QLabel#cabinetVal_loginTime,
QLabel#cabinetVal_credits,
QLabel#cabinetVal_vip,
QLabel#cabinetVal_devices,
QLabel#cabinetVal_location,
QLabel#cabinetVal_status {
    color: #F8FAFC;
    font-size: 11px;
    font-weight: 700;
    background: transparent;
    border: none;
}

QFrame#toplevel_up_2 {
    background-color: #0B0F19;
    border-bottom: 1px solid #1E293B;
    border-radius: 0px;
}

QLabel#label_7 {
    color: #38BDF8;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1.2px;
    background: transparent;
}

QFrame#serviceContents {
    background: transparent;
    border: none;
}

ServiceTileButton {
    background: transparent;
    border: none;
    outline: none;
    padding: 0px;
    margin: 0px;
}

/* ==========================================
 * 3. Devices Connection Page (page_devices)
 * ========================================== */
QWidget#page_devices {
    background-color: #0A0E1A;
}

QScrollArea#scrollArea_2 {
    background: transparent;
    border: none;
}

QWidget#scrollAreaWidgetContents_2 {
    background: transparent;
}

QFrame#device_left_group {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 0px;
}

QLabel#label_5 {
    background-color: #0B1120;
    border: 1px solid #1E3A5F;
    border-radius: 0px;
    color: #38BDF8;
    font-size: 12.5px;
    font-weight: 600;
    padding: 10px;
}

/* ==========================================
 * 4. Procedures & Scan Execution (page_adsmalware)
 * ========================================== */
QWidget#page_adsmalware {
    background-color: #0A0E1A;
}

QLabel#deviceLabelName {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 0px;
    color: #38BDF8;
    font-size: 14px;
    font-weight: bold;
    font-style: normal;
    padding: 8px 16px;
}

QListView#processLogStatus {
    background-color: #080C14;
    border: 1px solid #1E293B;
    border-radius: 0px;
    color: #94A3B8;
    font-family: 'Consolas', 'DejaVu Sans Mono', 'Courier New', monospace;
    font-size: 11px;
    padding: 8px;
}

QListView#processLogStatus::item:selected {
    background-color: #0284C7;
    color: #FFFFFF;
}

QProgressBar#processBarStatus {
    background-color: #0B0F19;
    border: 1px solid #1E293B;
    border-radius: 0px;
    height: 16px;
    text-align: center;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: bold;
}

QProgressBar#processBarStatus::chunk {
    background-color: #0284C7;
    border-radius: 0px;
}

QLabel#malwareStatusText0 {
    color: #F8FAFC;
    font-size: 14px;
    font-weight: 600;
    padding: 6px;
    font-style: normal;
    text-decoration: none;
}

QPushButton#malwareReRun {
    background-color: #0284C7;
    border: 1px solid #0284C7;
    border-radius: 0px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 20px;
}

QPushButton#malwareReRun:hover {
    background-color: #0369A1;
    border-color: #38BDF8;
}

QPushButton#malwareReRun:pressed {
    background-color: #075985;
    border-color: #0284C7;
}

/* ==========================================
 * 5. Loader Page (page_loader)
