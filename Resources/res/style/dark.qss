}

QWidget#page_apkmanager QTabWidget::pane {
    border: none;
    background-color: #2c2c2e;
    border-radius: 12px;
}

QWidget#page_apkmanager QTabBar::tab {
    background-color: #2c2c2e;
    color: #98989d;
    padding: 7px 16px;
    font-size: 11.5px;
    font-weight: 600;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QWidget#page_apkmanager QTabBar::tab:selected {
    background-color: #1c1c1e;
    color: #0071e3;
    border-bottom: 2px solid #0071e3;
}

QWidget#page_apkmanager QTabBar::tab:hover:!selected {
    background-color: #2c2c2e;
    color: #ffffff;
}

QWidget#page_apkmanager QTextEdit {
    background-color: #1c1c1e;
    color: #e5e5ea;
    border: 1px solid #38383a;
    border-radius: 10px;
    selection-background-color: #0071e3;
}

QWidget#page_apkmanager QComboBox {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #38383a;
    border-radius: 10px;
    padding: 6px 12px;
}

QWidget#page_apkmanager QComboBox:hover {
    border-color: #0071e3;
    background-color: #2c2c2e;
}

QWidget#page_apkmanager QComboBox QAbstractItemView {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #38383a;
    border-radius: 10px;
    selection-background-color: #0071e3;
    selection-color: #ffffff;
    padding: 4px;
}

/* ==========================================
 * 11. Global Metro UI Fallback Rules
 * ========================================== */
QDialog {
    background-color: #1c1c1e;
    border: 1px solid #38383a;
    border-radius: 0px;
}

QDialog QLabel {
    color: #f5f5f7;
    background-color: transparent;
}

QDialog QPushButton {
    background-color: #38383a;
    color: #f5f5f7;
    border: 1px solid #48484a;
    border-radius: 10px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
    min-width: 75px;
}

QDialog QPushButton:hover {
    background-color: #48484a;
    border-color: #0071e3;
    color: #ffffff;
}

QDialog QPushButton:pressed {
    background-color: #0071e3;
    border-color: #0071e3;
}

QMessageBox {
    background-color: #2c2c2e;
    border: 1px solid #38383a;
    border-radius: 0px;
}

QMessageBox QLabel {
    color: #f5f5f7;
    background: transparent;
}

QMessageBox QPushButton {
    background-color: #38383a;
    color: #f5f5f7;
    border: 1px solid #48484a;
    border-radius: 10px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: bold;
    min-width: 80px;
}

QMessageBox QPushButton:hover {
    background-color: #48484a;
    border-color: #0071e3;
}

QMessageBox QPushButton:pressed {
    background-color: #2c2c2e;
}

QTabWidget::pane {
    border: none;
    background-color: #2c2c2e;
    border-radius: 12px;
}

QTabBar::tab {
    background-color: #2c2c2e;
    color: #98989d;
    padding: 7px 16px;
    font-size: 11.5px;
    font-weight: 600;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #1c1c1e;
    color: #0071e3;
    border-bottom: 2px solid #0071e3;
}

QTabBar::tab:hover:!selected {
    background-color: #2c2c2e;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #2c2c2e;
    color: #98989d;
    font-weight: 700;
    font-size: 11px;
    border: none;
    border-bottom: 1px solid #38383a;
    border-right: 1px solid #2c2c2e;
    padding: 6px 10px;
}
