/* ===================================================================
 * AdsKiller Desktop - DARK theme
 * Tokens: bg #1c1c1e, card #2c2c2e, separator #38383a,
 *         text #f5f5f7, secondary #98989d, accent #0071e3
 * =================================================================== */


/* ==========================================
 * 0. Global Window and Controls Styling
 * ========================================== */
QWidget {
    color: #f5f5f7;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
}

QMainWindow,
QDialog {
    background-color: #1c1c1e;
    color: #f5f5f7;
}

QWidget#centralwidget {
    background-color: #1c1c1e;
}

QFrame#contentLayout {
    background-color: #1c1c1e;
    border: none;
}

/* Base Labels */
QLabel {
    background-color: transparent;
    color: #f5f5f7;
    border: none;
}

QLabel:disabled {
    color: #636366;
}

/* Base PushButtons (Metro Flat Default) */
QPushButton {
    background-color: #3a3a3c;
    color: #f5f5f7;
    border: none;
    border-radius: 10px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
    outline: none;
}

QPushButton:hover {
    background-color: #48484a;
    color: #f5f5f7;
}

QPushButton:pressed {
    background-color: #545456;
    color: #f5f5f7;
}

QPushButton:disabled {
    background-color: #2c2c2e;
    color: #636366;
}

/* Base Text Inputs & Edits */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QTextBrowser {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #38383a;
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 12px;
    selection-background-color: #0071e3;
    selection-color: #ffffff;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QTextBrowser:hover {
    border-color: #48484a;
    background-color: #2c2c2e;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QTextBrowser:focus {
    border: 1px solid #0071e3;
    background-color: #2c2c2e;
    color: #f5f5f7;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QTextBrowser:disabled {
    background-color: #2c2c2e;
    color: #636366;
    border-color: #38383a;
}

/* Base ComboBox */
QComboBox {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #38383a;
    border-radius: 10px;
    padding: 4px 28px 4px 12px;
    font-size: 12px;
    min-height: 24px;
}

QComboBox:hover {
    border-color: #48484a;
    background-color: #2c2c2e;
}

QComboBox:focus,
QComboBox:on {
    border: 1px solid #0071e3;
    background-color: #2c2c2e;
}

QComboBox:disabled {
    background-color: #2c2c2e;
    color: #636366;
    border-color: #38383a;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: transparent;
}

QComboBox::drop-down:hover {
    background-color: transparent;
}

QComboBox::down-arrow {
    image: url(:/svg/arrow-down);
    width: 12px;
    height: 12px;
}

QComboBox::down-arrow:hover,
QComboBox::down-arrow:on {
    image: url(:/svg/arrow-down-hover);
}


QComboBox QAbstractItemView {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #38383a;
    border-radius: 10px;
    selection-background-color: #0071e3;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}

/* Base Item Views (Tables, Lists, Trees) */
QAbstractItemView,
QTableView,
QTableWidget,
QListView,
QListWidget,
QTreeView,
QTreeWidget {
    background-color: #2c2c2e;
    alternate-background-color: #323234;
    color: #f5f5f7;
    border: none;
    border-radius: 12px;
    gridline-color: #38383a;
    selection-background-color: #0071e3;
    selection-color: #ffffff;
    outline: none;
}

QAbstractItemView::item:hover,
QTableView::item:hover,
QTableWidget::item:hover,
QListView::item:hover,
QListWidget::item:hover {
    background-color: #2c2c2e;
    color: #0071e3;
}

QAbstractItemView::item:selected,
QTableView::item:selected,
QTableWidget::item:selected,
QListView::item:selected,
QListWidget::item:selected {
    background-color: #0071e3;
    color: #ffffff;
}

/* Base Headers */
QHeaderView {
    background-color: #1c1c1e;
    border: none;
}

QHeaderView::section {
    background-color: #1c1c1e;
    color: #98989d;
    font-weight: 700;
    font-size: 11px;
    border: none;
    border-bottom: 1px solid #38383a;
    border-right: 1px solid #2c2c2e;
    padding: 6px 10px;
}

QTableCornerButton::section {
    background-color: #1c1c1e;
    border: none;
    border-bottom: 1px solid #38383a;
    border-right: 1px solid #2c2c2e;
}

/* Base ScrollArea */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Base TabWidget and TabBar */
QTabWidget::pane {
    border: none;
    background-color: #2c2c2e;
    border-radius: 12px;
}

QTabBar::tab {
    background-color: #2c2c2e;
    color: #98989d;
    padding: 7px 16px;
    font-size: 11.5px;
    font-weight: 600;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #1c1c1e;
    color: #0071e3;
    border-bottom: 2px solid #0071e3;
}

QTabBar::tab:hover:!selected {
    background-color: #2c2c2e;
    color: #ffffff;
}

/* Base GroupBox */
QGroupBox {
    border: 1px solid #38383a;
    border-radius: 12px;
    margin-top: 14px;
    padding-top: 12px;
    color: #0071e3;
    font-weight: 700;
    font-size: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 6px;
    background: transparent;
}

/* SpinBoxes */
QSpinBox,
QDoubleSpinBox {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #38383a;
    border-radius: 10px;
    padding: 5px 10px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #0071e3;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 18px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #48484a;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #48484a;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #0071e3;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #ffffff;
    border: 1px solid #98989d;
    width: 16px;
    height: 16px;
    margin: -7px 0px;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #ffffff;
    border-color: #0071e3;
}

/* ProgressBars */
QProgressBar {
    background-color: #3a3a3c;
    border: none;
    border-radius: 7px;
    text-align: center;
    color: #f5f5f7;
    font-size: 11px;
    font-weight: 600;
    height: 14px;
}

QProgressBar::chunk {
    background-color: #0071e3;
    border-radius: 7px;
}

/* MenuBar and Menus */
QMenuBar {
    background-color: #1c1c1e;
    color: #f5f5f7;
    border-bottom: 1px solid #38383a;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    color: #f5f5f7;
}

QMenuBar::item:selected {
    background-color: #38383a;
    color: #0071e3;
}

QMenuBar::item:pressed {
    background-color: #0071e3;
    color: #ffffff;
}

/* StatusBar */
QStatusBar {
    background-color: #1c1c1e;
    color: #98989d;
    border-top: 1px solid #38383a;
}

QStatusBar::item {
    border: none;
}

/* Metro Flat Scrollbars */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #636366;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #8e8e93;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #636366;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #8e8e93;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* Global CheckBoxes */
QCheckBox {
    color: #f5f5f7;
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #636366;
    border-radius: 5px;
    background-color: #2c2c2e;
}

QCheckBox::indicator:hover {
    border-color: #0071e3;
    background-color: #2c2c2e;
}

QCheckBox::indicator:checked {
    background-color: #0071e3;
    border-color: #0071e3;
    image: url(:/resources/checkbox-checked);
}

/* Global RadioButtons */
QRadioButton {
    color: #f5f5f7;
    spacing: 8px;
    background: transparent;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #636366;
    border-radius: 10px;
    background-color: #2c2c2e;
}

QRadioButton::indicator:hover {
    border-color: #0071e3;
}

QRadioButton::indicator:checked {
    width: 8px;
    height: 8px;
    background-color: #ffffff;
    border: 5px solid #0071e3;
    border-radius: 9px;
}

/* Tooltips */
QToolTip {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #38383a;
    border-radius: 8px;
    padding: 5px 8px;
    font-size: 11px;
}

/* Context Menus */
QMenu {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #38383a;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 6px;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #0071e3;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #38383a;
    margin: 4px 8px;
}

/* ==========================================
 * 1. Authentication Page (page_auth)
 * ========================================== */
QWidget#page_auth {
    background-color: #1c1c1e;
}

QFrame#frame_4 {
    background-color: #2c2c2e;
    border: none;
    border-radius: 16px;
}

QFrame#mainapplogo {
    image: url(:/resources/app-logo);
    background-color: #1c1c1e;
    border: 1px solid #38383a;
    border-radius: 12px;
    padding: 10px;
}

QFrame#mainapplogo[holiday="true"] {
    image: url(:/resources/app-logo-merry);
}

QLabel#label_4 {
    background: transparent;
}

QLabel#label_12 {
    color: #98989d;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    background: transparent;
}

QLineEdit#lineLoginEdit {
    background-color: #1c1c1e;
    color: #f5f5f7;
    border: 1px solid #38383a;
    border-radius: 10px;
    padding: 0 10px;
    font-size: 13px;
    selection-background-color: #0071e3;
}

QLineEdit#lineLoginEdit:hover {
    border-color: #48484a;
    background-color: #1c1c1e;
}

QLineEdit#lineLoginEdit:focus {
    border: 1px solid #0071e3;
    background-color: #2c2c2e;
}

QLineEdit#lineLoginEdit:disabled {
    background-color: #1c1c1e;
    color: #636366;
    border-color: #38383a;
}

QLabel#label_14 {
    color: #98989d;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    background: transparent;
}

QLineEdit#linePassEdit {
    background-color: #1c1c1e;
    color: #f5f5f7;
    border: 1px solid #38383a;
    border-radius: 10px;
    padding: 0 10px;
    font-size: 13px;
    selection-background-color: #0071e3;
}

QLineEdit#linePassEdit:hover {
    border-color: #48484a;
    background-color: #1c1c1e;
}

QLineEdit#linePassEdit:focus {
    border: 1px solid #0071e3;
    background-color: #2c2c2e;
}

QLineEdit#linePassEdit:disabled {
    background-color: #1c1c1e;
    color: #636366;
    border-color: #38383a;
}

QPushButton#butShowPass {
    background-color: #2c2c2e;
    color: #98989d;
    border: 1px solid #38383a;
    border-radius: 10px;
    font-size: 15px;
}

QPushButton#butShowPass:hover {
    background-color: #38383a;
    border-color: #0071e3;
    color: #0071e3;
}

QPushButton#butShowPass:pressed {
    background-color: #1c1c1e;
    border-color: #0071e3;
}

QCheckBox#checkAutoLogin {
    color: #98989d;
    font-size: 12px;
    font-weight: 500;
    spacing: 8px;
    background: transparent;
}

QCheckBox#checkAutoLogin:hover {
    color: #e5e5ea;
}

QCheckBox#checkAutoLogin::indicator {
    width: 17px;
    height: 17px;
    border: 1px solid #48484a;
    border-radius: 5px;
    background-color: #2c2c2e;
}

QCheckBox#checkAutoLogin::indicator:hover {
    border-color: #0071e3;
    background-color: #2c2c2e;
}

QCheckBox#checkAutoLogin::indicator:checked {
    background-color: #0071e3;
    border-color: #0071e3;
    image: url(:/resources/checkbox-checked);
}

QLabel#label_2 {
    color: #0071e3;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}

QCheckBox#checkConsent {
    color: #98989d;
    font-size: 11px;
    font-weight: 400;
    spacing: 8px;
    background: transparent;
}

QCheckBox#checkConsent:hover {
    color: #e5e5ea;
}

QCheckBox#checkConsent::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #48484a;
    border-radius: 5px;
    background-color: #2c2c2e;
}

QCheckBox#checkConsent::indicator:hover {
    border-color: #0071e3;
    background-color: #2c2c2e;
}

QCheckBox#checkConsent::indicator:checked {
    background-color: #0071e3;
    border-color: #0071e3;
    image: url(:/resources/checkbox-checked);
}

QLabel#consentLabel {
    background: transparent;
    font-size: 11px;
}

QPushButton#authButton {
    background-color: #0071e3;
    color: #ffffff;
    border: 1px solid #0071e3;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QPushButton#authButton:hover {
    background-color: #0077ed;
    border-color: #0071e3;
}

QPushButton#authButton:pressed {
    background-color: #0062c4;
    border-color: #0071e3;
}

QPushButton#authButton:disabled {
    background-color: #38383a;
    border-color: #48484a;
    color: #8e8e93;
}

QLabel#statusAuthText {
    color: #0071e3;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
    padding: 2px 8px;
}

QLabel#label_auth_ver {
    color: #636366;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3px;
    background: transparent;
}

/* ==========================================
 * 2. Cabinet Page (page_cabinet)
 * ========================================== */
QWidget#page_cabinet {
    background-color: #1c1c1e;
}

QScrollArea#scrollArea_3,
QWidget#scrollAreaWidgetContents_3 {
    background: transparent;
    border: none;
}

QFrame#toplevel_up {
    background-color: #1c1c1e;
    border-bottom: 1px solid #38383a;
}

QLabel#label_6 {
    color: #f5f5f7;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 0.5px;
    font-style: normal;
    background: transparent;
}

QPushButton#logoutButton {
    background-color: #2c2c2e;
    color: #f87171;
    border: none;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 12px;
}

QPushButton#logoutButton:hover {
    background-color: #7f1d1d;
    color: #ffffff;
    border-color: #ef4444;
}

QPushButton#logoutButton:pressed {
    background-color: #450a0a;
    border-color: #991b1b;
}

QPushButton#authpageUpdate {
    background-color: #2c2c2e;
    border: 1px solid #38383a;
    border-radius: 10px;
    color: #0071e3;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 12px;
}

QPushButton#authpageUpdate:hover {
    background-color: #38383a;
    border-color: #0071e3;
    color: #ffffff;
}

QPushButton#authpageUpdate:pressed {
    background-color: #1c1c1e;
    border-color: #0071e3;
}

QFrame#frame_7 {
    background-color: #2c2c2e;
    border: none;
    border-radius: 12px;
    padding: 6px 12px;
}

QFrame#authedMainWin {
    background: transparent;
    border: none;
    border-radius: 0px;
}

QFrame#frame_3 {
    image: url(:/resources/no-avatar);
    border: 1.5px solid #0071e3;
    border-radius: 12px;
    background-color: #2c2c2e;
    padding: 2px;
}

QLabel#labelLoginAuthed {
    color: #f5f5f7;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    background: transparent;
    border: none;
}

QLabel#cabinetRoleBadge {
    color: #8e8e93;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    background: transparent;
    border: none;
}

QLabel#cabinetOnlineBadge {
    color: #34d399;
    background-color: rgba(52, 211, 153, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.30);
    border-radius: 8px;
    font-size: 9.5px;
    font-weight: 700;
    padding: 2px 7px;
}

QPushButton#buttonAddCredits {
    background-color: #065f46;
    color: #ffffff;
    font-size: 11.5px;
    font-weight: 700;
    border: none;
    border-radius: 10px;
    padding: 4px 12px;
}

QPushButton#buttonAddCredits:hover {
    background-color: #059669;
    border-color: #34d399;
}

QPushButton#buttonAddCredits:pressed {
    background-color: #047857;
}

QPushButton#buttonAddVip {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fde047, stop:0.5 #f59e0b, stop:1 #d97706);
    color: #000000;
    font-size: 11px;
    font-weight: 800;
    border: none;
    border-radius: 10px;
    padding: 2px 10px;
}

QPushButton#buttonAddVip:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fef08a, stop:0.5 #fbbf24, stop:1 #f59e0b);
    border-color: #fde047;
    color: #000000;
}

QPushButton#buttonAddVip:pressed {
    background: #d97706;
    border-color: #b45309;
    color: #000000;
}

QFrame#cabinetHorizontalDivider {
    background-color: #38383a;
    max-height: 1px;
    border: none;
}

QFrame#cabinetHorizontalRefPanel {
    background: transparent;
    border: none;
}

QFrame#cabinetSideRow,
QFrame[cabinetChip="true"] {
    background-color: #1c1c1e;
    border: 1px solid #38383a;
    border-radius: 10px;
    padding: 2px 6px;
}

QFrame#cabinetSideRow:hover,
QFrame[cabinetChip="true"]:hover {
    border-color: #48484a;
    background-color: #2c2c2e;
}

QLabel#cabinetSideIcon {
    background: transparent;
    border: none;
}

QLabel#cabinetSideCaption {
    color: #8e8e93;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    background: transparent;
    border: none;
}

QLabel[cabinetVal="true"],
QLabel#cabinetVal_login,
QLabel#cabinetVal_loginTime,
QLabel#cabinetVal_credits,
QLabel#cabinetVal_vip,
QLabel#cabinetVal_devices,
QLabel#cabinetVal_location,
QLabel#cabinetVal_status {
    color: #f5f5f7;
    font-size: 11px;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel#cabinetVal_credits,
QLabel#cabinetVal_status {
    color: #34d399;
}

QLabel#cabinetVal_vip {
    color: #fbbf24;
}

