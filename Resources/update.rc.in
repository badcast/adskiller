#include <winver.h>

#define IDR_APPICON 101
IDR_APPICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/Resources/res/icon_update.ico"

#ifndef CREATEPROCESS_MANIFEST_RESOURCE_ID
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#endif
#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "update.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @RC_VERSION_COMMA@
PRODUCTVERSION  @RC_VERSION_COMMA@
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "badcast\0"
            VALUE "FileDescription",  "AdsKiller Update Manager\0"
            VALUE "FileVersion",      "@RC_VERSION_STRING@\0"
            VALUE "InternalName",     "update.exe\0"
            VALUE "LegalCopyright",   "Copyright (C) @CURRENT_YEAR@ badcast <lmecomposer[at]gmail[dot]com>\0"
            VALUE "OriginalFilename", "update.exe\0"
            VALUE "ProductName",      "AdsKiller\0"
            VALUE "ProductVersion",   "@RC_VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
